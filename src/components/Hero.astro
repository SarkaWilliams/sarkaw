---
import { getHomeContent } from "../lib/content";
import { nbsp } from "../lib/typography";
import { normalizeLocale } from "../lib/i18n";

interface Props {
  ctaHref: string;
}

const { ctaHref } = Astro.props;
const home = getHomeContent(normalizeLocale(Astro.currentLocale));
---

<section class="hero" id="hero">
  <div class="container container--content hero__inner">
    <h1>{nbsp(home.heroTitle)}</h1>
    <p class="hero__subtitle">{nbsp(home.heroSubtitle)}</p>
    {home.heroQuote && <p class="hero__quote">{nbsp(home.heroQuote)}</p>}
    <a class="button" href={ctaHref}>{home.ctaText}</a>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1023px) {
    .hero__inner {
      max-width: 56rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      text-align: center;
    }

    .hero__inner .button {
      align-self: center;
    }
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    text-wrap: pretty;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .hero__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    margin: 0 0 2rem;
  }
</style>
