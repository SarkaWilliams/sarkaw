---
import { getHomeContent } from "../lib/content";
import { normalizeLocale } from "../lib/i18n";

const home = getHomeContent(normalizeLocale(Astro.currentLocale));
---

<section class="pricing" id="cena">
  <div class="container pricing__inner">
    <h2>{home.pricing.title}</h2>
    <p>{home.pricing.text}</p>
  </div>
</section>

<style>
  .pricing {
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .pricing__inner {
    max-width: var(--max-width);
  }

  .pricing p {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
