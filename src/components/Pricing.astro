---
import { getHomeContent } from "../lib/content";
import { nbsp } from "../lib/typography";
import { normalizeLocale } from "../lib/i18n";

const home = getHomeContent(normalizeLocale(Astro.currentLocale));
---

<section class="pricing" id="cena">
  <div class="container container--content pricing__inner">
    <h2>{nbsp(home.pricing.title)}</h2>
    <p class="section-intro">{nbsp(home.pricing.text)}</p>
  </div>
</section>

<style>
  .pricing {
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .pricing p {
    color: var(--color-text-muted);
    margin-block: 0;
  }
</style>
