---
import { getHomeContent } from "../lib/content";
import { normalizeLocale, ui } from "../lib/i18n";
import { WEB3FORMS_ACCESS_KEY, WEB3FORMS_ENDPOINT } from "../lib/web3forms";

const locale = normalizeLocale(Astro.currentLocale);
const home = getHomeContent(locale);
const t = ui[locale];
---

<section class="contact" id="kontakt">
  <div class="container contact__inner">
    <h2>{t.sections.contactHeading}</h2>
    <ul class="contact__list">
      <li>{home.contact.name}</li>
      <li>{t.contactLabels.ico}: {home.contact.ico}</li>
      <li>{home.contact.address}</li>
      <li>
        {t.contactLabels.email}: <a href={`mailto:${home.contact.email}`}>{home.contact.email}</a>
      </li>
      <li>
        {t.contactLabels.phone}: <a href={`tel:${home.contact.phone.replace(/\s+/g, "")}`}>{home.contact.phone}</a>
      </li>
    </ul>
    <div class="contact__socials">
      <a
        class="social-link"
        href={home.contact.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.socialAria.linkedin}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
      <a
        class="social-link"
        href={home.contact.facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.socialAria.facebook}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </a>
      <a
        class="social-link"
        href={home.contact.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.socialAria.instagram}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    </div>
    <div class="contact-form-wrapper">
      <h3 class="contact__form-heading">{home.contact.formHeading}</h3>
      <form
        class="contact-form"
        data-success-message={home.contact.formSuccessMessage}
        data-error-message={t.contactForm.errorMessage}
        data-sending-label={t.contactForm.sendingLabel}
        data-submit-label={t.contactForm.submitLabel}
      >
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="Nová zpráva z webu sarkawilliams" />
        <input type="checkbox" name="botcheck" class="contact-form__botcheck" tabindex="-1" autocomplete="off" />
        <div class="contact-form__field">
          <label for="cf-name">{t.contactForm.nameLabel}</label>
          <input id="cf-name" name="name" type="text" required />
        </div>
        <div class="contact-form__field">
          <label for="cf-email">{t.contactForm.emailLabel}</label>
          <input id="cf-email" name="email" type="email" required />
        </div>
        <div class="contact-form__field">
          <label for="cf-phone">{t.contactForm.phoneLabel}</label>
          <input id="cf-phone" name="phone" type="tel" />
        </div>
        <div class="contact-form__field">
          <label for="cf-message">{t.contactForm.messageLabel}</label>
          <textarea id="cf-message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="button">{t.contactForm.submitLabel}</button>
      </form>
      <p class="contact-form__status" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    max-width: 36rem;
  }

  .contact__list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    color: var(--color-text-muted);
  }

  .contact__list li {
    margin-bottom: 0.5rem;
  }

  .contact__list a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .contact__socials {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    color: var(--color-accent);
    transition: opacity 0.15s ease;
  }

  .social-link svg {
    width: 22px;
    height: 22px;
  }

  .social-link:hover,
  .social-link:focus-visible {
    opacity: 0.75;
  }

  .social-link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact-form-wrapper {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .contact__form-heading {
    margin: 0 0 1rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form__botcheck {
    display: none;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact-form__field label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    font: inherit;
    padding: 0.65em 0.85em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-accent-contrast);
    color: var(--color-text);
  }

  .contact-form__field textarea {
    resize: vertical;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 1px;
  }

  .contact-form .button {
    align-self: flex-start;
    border: none;
    cursor: pointer;
  }

  .contact-form .button:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .contact-form__status {
    margin: 1rem 0 0;
    font-weight: 600;
  }

  .contact-form__status--success {
    color: var(--color-accent);
  }

  .contact-form__status--error {
    color: #b3261e;
  }
</style>

<script define:vars={{ endpoint: WEB3FORMS_ENDPOINT }}>
  document.querySelectorAll(".contact-form").forEach((form) => {
    const wrapper = form.closest(".contact-form-wrapper");
    const status = wrapper?.querySelector(".contact-form__status");
    const submitBtn = form.querySelector('button[type="submit"]');
    const submitLabel = form.dataset.submitLabel ?? submitBtn?.textContent ?? "";
    const sendingLabel = form.dataset.sendingLabel ?? submitLabel;
    const successMessage = form.dataset.successMessage ?? "";
    const errorMessage = form.dataset.errorMessage ?? "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = sendingLabel;
      }
      if (status) {
        status.textContent = "";
        status.classList.remove("contact-form__status--success", "contact-form__status--error");
      }

      try {
        const formData = new FormData(form);
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: formData,
        });
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "submit failed");
        }

        form.hidden = true;
        if (status) {
          status.textContent = successMessage;
          status.classList.add("contact-form__status--success");
        }
      } catch {
        if (status) {
          status.textContent = errorMessage;
          status.classList.add("contact-form__status--error");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });
  });
</script>
