---
import { getHomeContent } from "../lib/content";
import { normalizeLocale, ui } from "../lib/i18n";

const locale = normalizeLocale(Astro.currentLocale);
const home = getHomeContent(locale);
const t = ui[locale];

// `about` je psáno jako markdown (widget: markdown ve Sveltia).
// Zatím render jako prostý text s odstavci; při potřebě lze napojit markdown parser.
const paragraphs = home.about.split(/\n\s*\n/).filter(Boolean);
---

<section class="about" id="o-mne">
  <div class="container about__inner">
    <img class="about__photo" src={home.aboutImage} alt={t.sections.aboutPhotoAlt} />
    <div class="about__content">
      <h2>{t.sections.aboutHeading}</h2>
      {paragraphs.map((p) => <p>{p}</p>)}
      {home.aboutBadges.length > 0 && (
        <>
          <p class="about__credentials-heading">{t.sections.credentialsHeading}</p>
          <ul class="about__credentials">
            {home.aboutBadges.map((badge) => (
              <li class="about__credential">
                <img class="about__credential-badge" src={badge.image} alt={badge.alt} loading="lazy" />
                <span>{badge.alt}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .about__inner {
    max-width: 56rem;
    display: grid;
    grid-template-columns: minmax(0, 16rem) 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about__photo {
    width: 100%;
    border-radius: var(--radius);
  }

  .about p {
    color: var(--color-text-muted);
  }

  .about__credentials-heading {
    font-weight: 600;
    color: var(--color-text);
    margin: 1.5rem 0 0.5rem;
  }

  .about__credentials {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__credential {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-text-muted);
  }

  .about__credential-badge {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__photo {
      max-width: 14rem;
      margin: 0 auto;
    }

    .about__credentials {
      gap: 0.65rem;
    }

    .about__credential {
      gap: 0.6rem;
    }

    .about__credential-badge {
      width: 42px;
      height: 42px;
    }
  }
</style>
