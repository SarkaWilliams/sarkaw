---
import { getHomeContent } from "../lib/content";
import { nbsp } from "../lib/typography";
import { normalizeLocale, ui } from "../lib/i18n";

const locale = normalizeLocale(Astro.currentLocale);
const home = getHomeContent(locale);
const t = ui[locale];

// `about` je psáno jako markdown (widget: markdown ve Sveltia).
// Zatím render jako prostý text s odstavci; při potřebě lze napojit markdown parser.
const paragraphs = home.about.split(/\n\s*\n/).filter(Boolean);
---

<section class="about" id="o-mne">
  <div class="container container--content about__inner">
    <img
      class="about__photo"
      src={home.aboutImage}
      alt={t.sections.aboutPhotoAlt}
      width="224"
      height="336"
    />
    <div class="about__content">
      <h2>{nbsp(t.sections.aboutHeading)}</h2>
      {paragraphs.map((p) => <p>{nbsp(p)}</p>)}
      {home.aboutBadgeGroups.filter((group) => group.items?.length > 0).map((group) => (
        <>
          {/* Dvojtečku doplňuje šablona — v CMS se nadpis píše bez ní. */}
          <p class="about__credentials-heading">{group.title.replace(/:\s*$/, "")}:</p>
          <ul class="about__credentials">
            {group.items.map((badge) => (
              <li class="about__credential">
                {badge.image && (
                  <img
                    class="about__credential-badge"
                    src={badge.image}
                    alt={badge.alt}
                    loading="lazy"
                    width="52"
                    height="52"
                  />
                )}
                <span>{badge.alt}</span>
              </li>
            ))}
          </ul>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 16rem) 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 1023px) {
    .about__inner {
      max-width: 56rem;
    }
  }

  .about__photo {
    width: 100%;
    border-radius: var(--radius);
  }

  /* Desktop: fotka má pevnou šířku 16rem (jako před rozšířením kontejneru),
     zbytek šířky dostává text. */
  @media (min-width: 1024px) {
    .about__inner {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 2.5rem;
    }

    .about__photo {
      width: 16rem;
      max-width: 100%;
      height: auto;
      aspect-ratio: 2 / 3;
      object-fit: cover;
    }
  }

  .about p {
    color: var(--color-text-muted);
  }

  .about__credentials-heading {
    font-weight: 600;
    color: var(--color-text);
    margin: 1.5rem 0 0.5rem;
  }

  .about__credentials {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__credential {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-text-muted);
  }

  .about__credential-badge {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__photo {
      max-width: 14rem;
      margin: 0 auto;
    }

    .about__credentials {
      gap: 0.65rem;
    }

    .about__credential {
      gap: 0.6rem;
    }

    .about__credential-badge {
      width: 42px;
      height: 42px;
    }
  }
</style>
