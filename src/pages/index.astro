---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Offerings from "../components/Offerings.astro";
import About from "../components/About.astro";
import Testimonials from "../components/Testimonials.astro";
import Process from "../components/Process.astro";
import Pricing from "../components/Pricing.astro";
import Contact from "../components/Contact.astro";
import { getHomeContent } from "../lib/content";

const home = getHomeContent("cs");
---

<Layout
  title={`${home.heroTitle} | Koučink`}
  description="Šárka Williams, ACC koučka akreditovaná ICF, nabízí osobní i business koučink. Pomáhám lidem i firmám najít jasnost, sebedůvěru a zdravé pracovní prostředí."
  translationPath=""
>
  <Hero ctaHref="#kontakt" />
  <Offerings />
  <About />
  <Testimonials />
  <Process />
  <Pricing />
  <Contact />
</Layout>
